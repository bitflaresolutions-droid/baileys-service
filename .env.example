# Port Railway/Fly will set PORT automatically; local default 3001
PORT=3001

# Shared API key. Every request from the Lovable app must send:
#   Authorization: Bearer <BAILEYS_API_KEY>
# Generate a strong random string (openssl rand -hex 32).
BAILEYS_API_KEY=change-me

# Where to POST webhook events (incoming messages, status updates, connection state).
# For the Lovable app use the published URL:
#   https://wa-reach-flow.lovable.app/api/public/webhooks/whatsapp
WEBHOOK_URL=https://wa-reach-flow.lovable.app/api/public/webhooks/whatsapp

# Optional shared secret sent as x-webhook-signature header on webhook POSTs.
# If set, the Lovable webhook route must verify it.
WEBHOOK_SECRET=

# Directory where session auth state is persisted. On Railway, mount a volume here.
SESSION_DIR=./sessions

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info
